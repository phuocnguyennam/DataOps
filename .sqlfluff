[sqlfluff]
# SQL lint configuration for the DBT models.
#
# We use the `jinja` templater with `apply_dbt_builtins` so `{{ source() }}` and
# `{{ ref() }}` resolve without a live database connection. This keeps SQL linting
# fast and fully self-contained in CI.
#
# If your models start using package/custom macros (e.g. dbt_utils.*) inside the
# SQL files themselves, switch `templater` to `dbt`, install
# `sqlfluff-templater-dbt`, and run `dbt parse` before linting.
templater = jinja
dialect = tsql

# Relax rules that are noisy for hand-written T-SQL casts.
exclude_rules = L016, L029, L034, L036, L038

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:rules:L010]
capitalisation_policy = upper
