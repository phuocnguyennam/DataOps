# Copy this file to `.env` for local development (never commit the real `.env`;
# `.env` is already in .gitignore).
#
# In CI/CD, the SAME variable names are supplied as GitHub Environment secrets
# (Settings -> Environments -> dev / prod). See DEPLOYMENT.md section 2.

# Default dbt target when `--target` is not passed (dev | prod)
DBT_TARGET=dev

# Shared connection variables (read by BOTH the `dev` and `prod` targets)
DBT_SQLSERVER_HOST=sqlserver
DBT_SQLSERVER_DATABASE=AdventureWorks2014
DBT_SCHEMA=dbo
DBT_SQLSERVER_USER=imrandbtnew
DBT_SQLSERVER_PASSWORD=Imran@12345

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url
